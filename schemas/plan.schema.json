{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plan-as-code.dev/schemas/plan.schema.json",
  "title": "Plan as Code Plan Record",
  "type": "object",
  "description": "Optional machine-readable projection of a PaC plan, derived per SPEC Section 20.1. Markdown remains the canonical human-readable format. Additional properties are permitted at the record level so repositories MAY extend records.",
  "required": [
    "id",
    "title",
    "status",
    "scope",
    "tasks"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^P[0-9]+$"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "description": "Plan status. Recommended values: Draft, Active, Closed."
    },
    "scope": {
      "type": "string"
    },
    "planner": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "pac_version": {
      "type": "string",
      "description": "The PaC protocol version the record was written against."
    },
    "current_iteration": {
      "type": "integer",
      "minimum": 1
    },
    "objective": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P[0-9]+-T[0-9]+$"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Draft",
              "Planned",
              "In Progress",
              "Implemented",
              "Verified",
              "Blocked",
              "Deferred",
              "Cancelled"
            ]
          },
          "owner": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "status"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^P[0-9]+-T[0-9]+-F[0-9]+$"
                },
                "title": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}