{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plan-as-code.dev/schemas/plan.schema.json",
  "title": "Plan as Code Plan Record",
  "type": "object",
  "description": "Optional machine-readable projection of a PaC Plan, derived per SPEC Section 20.1. Markdown remains the canonical human-readable format. Additional properties are permitted at the record level so repositories MAY extend records.",
  "required": [
    "id",
    "title",
    "status",
    "tasks"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^P[0-9]+$"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Planned",
        "Completed",
        "Cancelled"
      ]
    },
    "scope": {
      "type": "string"
    },
    "planner": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "pac_version": {
      "type": "string",
      "description": "The PaC protocol version the record was written against."
    },
    "objective": {
      "type": "string"
    },
    "included": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tasks": {
      "type": "array",
      "description": "References to Task records under `.plan/tasks/`.",
      "items": {
        "type": "string",
        "pattern": "^P[0-9]+-T[0-9]+$"
      }
    },
    "definition_of_done": {
      "type": "array",
      "description": "Plan-level conditions for marking the Plan `Completed` (SPEC Section 8.3).",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "done": {
            "type": "boolean"
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}